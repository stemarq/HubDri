# Porta do hub
PORT=3000

# URL pública do hub (usada nos links do PDF e no retorno para a IA do WhatsApp)
PUBLIC_URL=http://localhost:3000

# Token que a IA do WhatsApp envia no header "x-hub-token" ao chamar os webhooks do hub
HUB_WEBHOOK_TOKEN=troque-este-token

# Para onde o hub devolve o orçamento aprovado (endpoint da IA do WhatsApp).
# Vazio = usa o simulador interno (/api/mock/whatsapp), visível em "Saída WhatsApp" no hub.
WHATSAPP_CALLBACK_URL=
WHATSAPP_CALLBACK_TOKEN=

# Senha opcional para a interface do hub (HTTP Basic, usuário livre). Vazio = sem senha.
# Só vale sem Supabase: com SUPABASE_URL preenchido, o hub usa o login da equipe.
HUB_PASSWORD=

# IA do cálculo do orçamento: Claude e/ou Gemini. Sem chave, o hub usa o cálculo por regras.
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio → Get API key). Use o plano pago: no gratuito o Google pode usar os dados para treino.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Com as duas chaves, o Gemini tem preferência; para usar o Claude: IA_PROVEDOR=claude
# IA_PROVEDOR=gemini
# IA_DESATIVADA=1

# Supabase (banco + imagens). Vazio = grava em data/db.json.
# Painel do Supabase → Project Settings → API. Use a chave service_role: ela fica só no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
