# Obrigatório para endpoints administrativos (hub). Gere um valor longo e aleatório.
ADMIN_API_TOKEN=
PORT=3000
DB_PATH=data/adri.db
DATA_DIR=data
# Endereço-base de saída da Adriana (também editável em PUT /api/settings/pricing -> transport.baseAddress)
BASE_ADDRESS=

# WhatsApp Cloud API oficial (se vazio, apenas o simulador funciona)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Rotas (se vazio, usa provedor SIMULADO, sempre identificado como tal)
GOOGLE_MAPS_API_KEY=
ROUTE_PROVIDER=

# Google Calendar (OAuth refresh token). Se vazio, usa agenda SIMULADA.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Telegram: canal de SIMULAÇÃO do chat (crie o bot com @BotFather). Long polling, sem URL pública.
TELEGRAM_BOT_TOKEN=
# Opcional: chat ids permitidos, separados por vírgula (vazio = qualquer pessoa que achar o bot)
TELEGRAM_ALLOWED_CHAT_IDS=

# Notificação opcional ao hub (POST assinado HMAC-SHA256 em X-Adri-Signature)
HUB_WEBHOOK_URL=
HUB_WEBHOOK_SECRET=

# Caminho do Chrome/Edge para gerar PDF (autodetecta se vazio)
CHROME_PATH=
