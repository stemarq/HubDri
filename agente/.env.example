# Obrigatório para endpoints administrativos (hub). Gere um valor longo e aleatório.
ADMIN_API_TOKEN=
ADRI_PORT=3001   # porta do agente (o hub usa PORT)
DB_PATH=data/adri.db
DATA_DIR=data
# Endereço-base de saída da Adriana (também editável em PUT /api/settings/pricing -> transport.baseAddress)
BASE_ADDRESS=

# WhatsApp Cloud API oficial (se vazio, apenas o simulador funciona)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Rotas (se vazio, usa provedor SIMULADO, sempre identificado como tal)
GOOGLE_MAPS_API_KEY=
ROUTE_PROVIDER=

# Google Calendar (OAuth refresh token). Se vazio, usa agenda SIMULADA.
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Telegram: canal de SIMULAÇÃO do chat (crie o bot com @BotFather). Long polling, sem URL pública.
TELEGRAM_BOT_TOKEN=
# Opcional: chat ids permitidos, separados por vírgula (vazio = qualquer pessoa que achar o bot)
TELEGRAM_ALLOWED_CHAT_IDS=

# Notificação opcional ao hub (POST assinado HMAC-SHA256 em X-Adri-Signature)
HUB_WEBHOOK_URL=
HUB_WEBHOOK_SECRET=

# Gemini (recomendado: mesma chave do hub). Interpreta mensagens difíceis e transcreve áudios de voz.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODELO_RESERVA=gemini-3.5-flash-lite

# Alternativa ao Gemini: interpretação por LLM Anthropic (opcional): complementa as regras, nunca decide preço/agenda. Sem chave = só regras.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Transcrição de áudio (opcional, Whisper). Sem chave = a ADRI pede que a cliente escreva.
OPENAI_API_KEY=

# Caminho do Chrome/Edge para gerar PDF (autodetecta se vazio)
CHROME_PATH=

# ---- Integração com o hub (fila de orçamentos, PDF e aprovação da Adriana) ----
# Com HUB_URL preenchido, o agente envia cada pedido ao hub; o hub calcula, gera o PDF e a Adriana aprova no app.
HUB_URL=http://localhost:3002
HUB_WEBHOOK_TOKEN=      # igual ao HUB_WEBHOOK_TOKEN do .env do hub
HUB_CALLBACK_TOKEN=     # igual ao WHATSAPP_CALLBACK_TOKEN do .env do hub

# ---- Modo de teste (NUNCA em producao) ----
# SIMULAR=1 liga agenda/rotas/canal de teste simulados, usados so nos testes automatizados e em desenvolvimento.
# Sem isso: rotas reais (OpenStreetMap, ou Google com GOOGLE_MAPS_API_KEY) e Google Agenda real (ou "nao conectado", sem inventar horarios).
# SIMULAR=
# NOMINATIM_USER_AGENT=HubDri-agente/1.0 (seu contato)
