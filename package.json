{
  "name": "hubdri",
  "version": "0.1.0",
  "private": true,
  "description": "Hub de captação de clientes: recebe leads da IA do WhatsApp, calcula orçamento, gera PDF e coordena aprovações.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "env:novo": "node scripts/env-novo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.119.0",
    "express": "^4.21.2",
    "pdfkit": "^0.15.2"
  }
}
